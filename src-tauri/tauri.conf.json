{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Assistant",
  "version": "0.1.0",
  "identifier": "com.ryuky.simple-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Settings — Simple Assistant",
        "width": 840,
        "height": 640,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
